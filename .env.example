# Copy to .env and fill in. NEVER commit the real .env.
#
# OpenRouter API key used for BOTH the injector and the solver.
# The harness deliberately refuses to pass this variable into any sandbox
# process, so an injector agent with shell access cannot read it.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional OpenRouter attribution headers.
OPENROUTER_APP_URL=https://github.com/MachineLearningAmateur/AIBugAnalysis
OPENROUTER_APP_TITLE=SSR_SWEsmith_Coverage

# Optional: override the execution backend for a single run.
# One of: docker | wsl | local
SSR_EXEC_BACKEND=docker

# Optional: WSL distribution name used by the wsl backend.
SSR_WSL_DISTRO=Ubuntu

# Optional: scratch root for heavyweight artifacts. Keep this OUTSIDE Git.
# Suggested WSL/Linux location: ~/algoverse/ssr_swesmith_workspace
SSR_WORKSPACE_ROOT=
