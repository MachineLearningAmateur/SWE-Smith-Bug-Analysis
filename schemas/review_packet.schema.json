{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/swesmith-aidev-coverage/review_packet.schema.json",
  "title": "Neutral SWE-smith review packet (reviewer-visible)",
  "description": "The only artifact a blind reviewer may read for a case. It carries no generation method, no trajectory, no source model, no attempt count, no population frequency, no mirror repository name and no instance ID. scripts/build_swesmith_packets.py runs a leakage scan before a packet is written.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "packet_version",
    "repository",
    "bug_diff",
    "reference_repair",
    "specification",
    "code_context",
    "failing_tests",
    "evidence_ids"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^SWESMITH_(0[0-9][1-9]|0[1-9][0-9]|100)$"
    },
    "packet_version": {
      "type": "integer",
      "const": 2
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "bug_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "path",
        "sha256",
        "files_changed",
        "lines_added",
        "lines_deleted",
        "description"
      ],
      "properties": {
        "evidence_id": {
          "const": "BUG_DIFF"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "lines_added": {
          "type": "integer",
          "minimum": 0
        },
        "lines_deleted": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "reference_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "path",
        "sha256",
        "description"
      ],
      "properties": {
        "evidence_id": {
          "const": "REFERENCE_REPAIR"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "path",
        "sha256",
        "description"
      ],
      "properties": {
        "evidence_id": {
          "const": "SPECIFICATION"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "code_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "path",
          "repo_path",
          "sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^CODE_CONTEXT_[0-9]{2}$"
          },
          "path": {
            "type": "string"
          },
          "repo_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "failing_tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id_prefix",
        "path",
        "sha256",
        "failing_count",
        "passing_count",
        "tests"
      ],
      "properties": {
        "evidence_id_prefix": {
          "const": "TEST_FAILURE"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "failing_count": {
          "type": "integer",
          "minimum": 1
        },
        "passing_count": {
          "type": "integer",
          "minimum": 0
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "test_name"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^TEST_FAILURE_[0-9]{2}$"
              },
              "test_name": {
                "type": "string"
              },
              "test_file": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "reviewer_question": {
      "type": "string"
    }
  }
}
